---
import {
  catalogProducts,
  localizedCategory,
  translate,
  visibleCategories,
  type Locale,
} from "../lib/catalog-view";
import { CATALOG_CATEGORIES } from "../data/catalog";
import { CATALOG_PAGE_SIZE } from "../config/site";
import CatalogIllustrations from "./CatalogIllustrations.astro";
import CatalogProductCard from "./CatalogProductCard.astro";

interface Props {
  locale: Locale;
}

// Decorative line icons share the same viewBox and stroke treatment.
const giftIcon = "M3 8h18v4H3z M5 12v9h14v-9 M12 8v13 M12 8H8a3 3 0 1 1 3-3l1 3Zm0 0h4a3 3 0 1 0-3-3l-1 3Z";
const categoryIcons: Record<string, string> = {
  [CATALOG_CATEGORIES.FRIENDSHIP_LOVE]: "M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z",
  [CATALOG_CATEGORIES.BABIES_BIRTHS]: "M8 3H6L2 7l3 3 2-2v7l3 6h4l3-6V8l2 2 3-3-4-4h-2 M8 3a4 4 0 0 0 8 0 M7 15q5-2 10 0 M12 18v.01",
  [CATALOG_CATEGORIES.WELLNESS_SPA]: "M12 20C5 20 2 15 2 9c5 0 8 3 10 7 M12 20c7 0 10-5 10-11-5 0-8 3-10 7 M12 16C7 12 8 7 12 3c4 4 5 9 0 13Z",
  [CATALOG_CATEGORIES.SNOOPY_COLLECTION]: "M6 21v-6l-2-3V7l5-4h6l3 5 4 2v4l-5 2v5 M9 4l-1 7q2 4 4 0V5 M16 8h.01 M19 10h3 M6 18h11",
  [CATALOG_CATEGORIES.CUSTOM_BOXES]: giftIcon,
  [CATALOG_CATEGORIES.CUSTOM_SETS]: "M3 3h7v7H3z M14 3h7v7h-7z M3 14h7v7H3z M14 14h7v7h-7z",
  [CATALOG_CATEGORIES.CUSTOM_BONUSES]: "M5 7h14l2 14H3L5 7Z M9 7V5a3 3 0 0 1 6 0v2",
  [CATALOG_CATEGORIES.FRIENDS_BACHELORETTE]: "M4 3h6v5a3 3 0 0 1-6 0V3Zm10 0h6v5a3 3 0 0 1-6 0V3Z M7 11v9 M17 11v9 M4 20h6 M14 20h6 M4 6h6 M14 6h6",
  [CATALOG_CATEGORIES.PETS]: "M8 15c-5 6 0 8 4 5 4 3 9 1 4-5-2-4-6-4-8 0Z M6 8a2 3 0 1 1-4 0 2 3 0 1 1 4 0 M11 5a2 3 0 1 1-4 0 2 3 0 1 1 4 0 M17 5a2 3 0 1 1-4 0 2 3 0 1 1 4 0 M22 8a2 3 0 1 1-4 0 2 3 0 1 1 4 0",
  [CATALOG_CATEGORIES.CORPORATE_PACKAGING]: "M3 7h18v13H3z M8 7V3h8v4 M3 11q9 6 18 0 M12 12v4",
  [CATALOG_CATEGORIES.THERMOS_CUPS]: "M3 7h14v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7Z M17 8h2a3 3 0 0 1 0 6h-2 M6 2v2 M10 2v2 M14 2v2",
  [CATALOG_CATEGORIES.CREATIVE_STATIONERY]: "m4 15-1 6 6-1L21 8l-5-5L4 15Z M13 6l5 5 M4 15l5 5",
};
const { locale } = Astro.props;
const t = (key: Parameters<typeof translate>[1]) => translate(locale, key);
---

<section class="catalog-section" id="catalogo">
  <div class="catalog-intro">
    <CatalogIllustrations />
    <div class="wrap">
      <div class="section-heading catalog-heading">
        <div>
          <p class="eyebrow">{t("catalogEyebrow")}</p><h2>
            {t("catalogTitle")}
          </h2>
        </div>
      </div>
      <div class="catalog-toolbar">
        <label class="search-box"
          ><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.2 15.2 4.3 4.3" /></svg><input
            id="product-search"
            type="search"
            placeholder={t("searchPlaceholder")}
            aria-label={t("searchPlaceholder")}
          /></label
        ><div class="filter-navigation">
          <div class="filter-list" role="group" aria-label={t("filterAria")}>
            {
              visibleCategories.map((category) => (
                <button
                  type="button"
                  class="filter-button"
                  data-filter={category}
                  aria-pressed="false"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={categoryIcons[category]} /></svg>
                  <span>{localizedCategory(locale, category)}</span>
                </button>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="wrap">
    <div class="catalog-grid" id="product-grid">
      {
        catalogProducts.map((product, index) =>
          product.categories.includes(CATALOG_CATEGORIES.SNOOPY_COLLECTION) ? (
            <CatalogProductCard locale={locale} product={product} index={index} />
          ) : (
            <template data-deferred-card={index}>
              <CatalogProductCard locale={locale} product={product} index={index} />
            </template>
          ),
        )
      }
    </div>
    <div class="catalog-pagination" id="catalog-view-all-action" hidden>
      <button type="button" class="text-link catalog-view-all" id="catalog-view-all">
        {t("catalogViewAll")} <span aria-hidden="true">→</span>
      </button>
    </div>
    <div class="catalog-pagination" id="catalog-pagination">
      <p
        class="catalog-progress"
        id="catalog-progress"
        data-showing={t("catalogShowing")}
        data-of={t("catalogOf")}
        data-total={catalogProducts.length}
      ></p>
      <button
        type="button"
        class="button button-dark catalog-load-more"
        id="catalog-load-more"
        data-page-size={CATALOG_PAGE_SIZE}
        hidden={catalogProducts.length <= CATALOG_PAGE_SIZE}
      >{t("catalogLoadMore")} <span aria-hidden="true">↓</span></button>
    </div>
    <p class="empty-state" id="empty-state" hidden>{t("empty")}</p>
  </div>
</section>

<style>
  .catalog-view-all {
    align-self: center;
    max-width: 100%;
    min-height: 44px;
    padding: 10px 14px;
    border: 0;
    background: transparent;
    color: var(--evoka);
    white-space: normal;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
  }

  .catalog-view-all:focus-visible {
    outline: 2px solid var(--evoka);
    outline-offset: 4px;
  }

  /* The catalog owns spacing between cards at every breakpoint. */
  :global(#product-grid.catalog-grid):has(> .catalog-card:not([hidden])) {
    --catalog-row-spacing: 24px;
    row-gap: var(--catalog-row-spacing);
    margin-bottom: 0;
  }

  @media (max-width: 620px) {
    :global(#product-grid.catalog-grid):has(> .catalog-card:not([hidden])) {
      --catalog-row-spacing: 20px;
    }
  }

</style>

<script>
  import { CATALOG_CATEGORIES } from "../data/catalog";

  const search = document.querySelector<HTMLInputElement>("#product-search")!;
  const buttons = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-filter]"),
  ];
  const filterList = document.querySelector<HTMLElement>(".filter-list")!;
  let cards = [
    ...document.querySelectorAll<HTMLElement>(".catalog-card"),
  ];
  const empty = document.querySelector<HTMLElement>("#empty-state")!;
  const pagination = document.querySelector<HTMLElement>("#catalog-pagination")!;
  const viewAllAction = document.querySelector<HTMLElement>("#catalog-view-all-action")!;
  const viewAll = document.querySelector<HTMLButtonElement>("#catalog-view-all")!;
  const loadMore = document.querySelector<HTMLButtonElement>(
    "#catalog-load-more",
  )!;
  const progress = document.querySelector<HTMLElement>("#catalog-progress")!;
  const catalogPageSize = Number(loadMore.dataset.pageSize);
  const featuredLinks = [
    ...document.querySelectorAll<HTMLAnchorElement>(
      '.featured-image[href^="#product-"]',
    ),
  ];
  const deferredCards = () => [
    ...document.querySelectorAll<HTMLTemplateElement>("[data-deferred-card]"),
  ];
  const materializeDeferredCards = (matches: (card: HTMLElement) => boolean) => {
    deferredCards()
      .filter((template) => {
        const card = template.content.querySelector<HTMLElement>(".catalog-card");
        return card !== null && matches(card);
      })
      .forEach((template) => {
        // Replace in place to preserve catalog order across selective loads.
        template.replaceWith(template.content.cloneNode(true));
      });
    cards = [...document.querySelectorAll<HTMLElement>(".catalog-card")];
  };

  const highlightProduct = (id: string | null, updateHash = true) => {
    if (!id) return;
    const product = document.querySelector<HTMLElement>(id);
    if (!product) return;
    document
      .querySelectorAll(".catalog-card.is-highlighted")
      .forEach((card) => card.classList.remove("is-highlighted"));
    void product.offsetWidth;
    product.classList.add("is-highlighted");
    product.scrollIntoView({ behavior: "smooth", block: "center" });
    if (updateHash) history.replaceState(null, "", id);
    window.setTimeout(() => product.classList.remove("is-highlighted"), 1200);
  };

  // The initial product filter does not imply an explicit chip selection.
  let activeFilter: string = CATALOG_CATEGORIES.SNOOPY_COLLECTION;
  let visibleLimit = catalogPageSize;
  const clearActiveFilter = () => {
    activeFilter = "all";
    buttons.forEach((button) => {
      button.classList.remove("is-active");
      button.setAttribute("aria-pressed", "false");
    });
  };
  const update = () => {
    const query = search.value.toLowerCase().trim();
    viewAllAction.hidden = !(
      activeFilter === CATALOG_CATEGORIES.SNOOPY_COLLECTION &&
      query.length === 0 &&
      !buttons.some((button) => button.classList.contains("is-active"))
    );
    const showsAllMatches = activeFilter !== "all" || query.length > 0;
    const displayLimit = showsAllMatches
      ? Number.POSITIVE_INFINITY
      : visibleLimit;
    const matchesCurrentView = (card: HTMLElement) =>
      (card.dataset.name?.includes(query) ?? false) &&
      (activeFilter === "all" ||
        (card.dataset.categories?.split("|").includes(activeFilter) ?? false));
    materializeDeferredCards((card) =>
      matchesCurrentView(card) && Number(card.dataset.catalogIndex ?? 0) < displayLimit,
    );
    let matches = 0;
    const totalProducts = Number(progress.dataset.total ?? cards.length);
    let hiddenMatches = !showsAllMatches && totalProducts > displayLimit;
    cards.forEach((card) => {
      const matchesCard = matchesCurrentView(card);
      const index = Number(card.dataset.catalogIndex ?? 0);
      if (matchesCard) {
        matches++;
        if (index >= displayLimit) hiddenMatches = true;
      }
      const show = matchesCard && index < displayLimit;
      card.hidden = !show;
    });
    const matchingTotal = showsAllMatches ? matches : totalProducts;
    empty.hidden = matches !== 0;
    loadMore.hidden = !hiddenMatches;
    pagination.hidden = showsAllMatches;
    progress.textContent = `${progress.dataset.showing} ${Math.min(displayLimit, matchingTotal)} ${progress.dataset.of} ${matchingTotal}`;
  };

  featuredLinks.forEach((link) =>
    link.addEventListener("click", (event) => {
      event.preventDefault();
      search.value = "";
      visibleLimit = catalogPageSize;
      const filterButton = buttons.find(
        (button) => button.dataset.filter === link.dataset.featuredFilter,
      );
      if (filterButton && !filterButton.classList.contains("is-active"))
        filterButton.click();
      update();
      highlightProduct(link.getAttribute("href"));
    }),
  );

  buttons.forEach((button) =>
    button.addEventListener("click", () => {
      const wasActive = button.classList.contains("is-active");
      activeFilter = wasActive ? "all" : (button.dataset.filter ?? "all");
      visibleLimit = catalogPageSize;
      buttons.forEach((item) => {
        const selected = activeFilter !== "all" && item === button;
        item.classList.toggle("is-active", selected);
        item.setAttribute("aria-pressed", String(selected));
      });
      update();
      if (!wasActive) {
        const targetScroll =
          button.offsetLeft - (filterList.clientWidth - button.offsetWidth) / 2;
        filterList.scrollTo({
          left: Math.max(
            0,
            Math.min(
              targetScroll,
              filterList.scrollWidth - filterList.clientWidth,
            ),
          ),
          behavior: "smooth",
        });
      }
    }),
  );

  document
    .querySelectorAll<HTMLButtonElement>("[data-filter-link]")
    .forEach((link) =>
      link.addEventListener("click", () => {
        const button = buttons.find(
          (item) => item.dataset.filter === link.dataset.filterLink,
        );
        button?.click();
        document
          .querySelector<HTMLElement>("#catalogo")
          ?.scrollIntoView({ behavior: "smooth" });
      }),
  );
  viewAll.addEventListener("click", () => {
    clearActiveFilter();
    visibleLimit = catalogPageSize;
    update();
    loadMore.focus({ preventScroll: true });
  });
  loadMore.addEventListener("click", () => {
    visibleLimit += catalogPageSize;
    update();
  });
  search.addEventListener("input", () => {
    clearActiveFilter();
    visibleLimit = catalogPageSize;
    update();
  });
  update();
</script>
