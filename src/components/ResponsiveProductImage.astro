---
import {
  productImageUrl,
  productImageWidths,
} from "../lib/catalog-view";

interface Props {
  imageId: number;
  alt: string;
  loading?: "eager" | "lazy";
  sizes?: string;
}

const {
  imageId,
  alt,
  loading = "lazy",
  sizes = "(max-width: 720px) calc(100vw - 2rem), (max-width: 1100px) 45vw, 320px",
} = Astro.props;
const srcset = (format: "avif" | "webp") =>
  productImageWidths
    .map((width) => `${productImageUrl(imageId, format, width)} ${width}w`)
    .join(", ");
---

<picture>
  <source type="image/avif" srcset={srcset("avif")} sizes={sizes} />
  <source type="image/webp" srcset={srcset("webp")} sizes={sizes} />
  <img
    src={productImageUrl(imageId, "jpg")}
    alt={alt}
    loading={loading}
    decoding="async"
    fetchpriority={loading === "eager" ? "high" : undefined}
  />
</picture>
