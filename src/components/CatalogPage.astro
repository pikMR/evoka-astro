---
import CatalogSection from "./CatalogSection.astro";
import AboutModal from "./AboutModal.astro";
import CategoriesSection from "./CategoriesSection.astro";
import FeaturedSelection from "./FeaturedSelection.astro";
import Hero from "./Hero.astro";
import ProductModal from "./ProductModal.astro";
import PromiseBand from "./PromiseBand.astro";
import SecurePaymentModal from "./SecurePaymentModal.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import ShippingModal from "./ShippingModal.astro";
import { assetUrl, translate, type Locale } from "../lib/catalog-view";
import "../styles/global.css";
import "../styles/header.css";
import "../styles/catalog.css";
import "../styles/footer.css";
import "../styles/modals.css";

interface Props {
  locale?: Locale;
}

const { locale = "es" } = Astro.props;
const t = (key: Parameters<typeof translate>[1]) => translate(locale, key);
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={t("siteDescription")} />
    <meta name="theme-color" content="#f6f3ed" />
    <link rel="icon" href={assetUrl("favicon.svg")} type="image/svg+xml" />
    <link rel="mask-icon" href={assetUrl("favicon.svg")} color="#2e180a" />
    <title>{t("siteTitle")}</title>
  </head>
  <body>
    <SiteHeader locale={locale} />
    <main id="inicio">
      <Hero locale={locale} />
      <PromiseBand locale={locale} />
      <FeaturedSelection locale={locale} />
      <CatalogSection locale={locale} />
      <CategoriesSection locale={locale} />
    </main>
    <SiteFooter locale={locale} />
    <ProductModal locale={locale} />
    <SecurePaymentModal locale={locale} />
    <AboutModal locale={locale} />
    <ShippingModal locale={locale} />
  </body>
</html>
