---
import { categories, products } from "../data/catalog";
import "../styles/global.css";
import {
  ui,
  categoryTranslations,
  productTranslations,
  productTranslationsExtra,
  whatsappCatalogs,
} from "../i18n/ui";

interface Props {
  locale?: "es" | "en" | "fr";
}
const { locale = "es" } = Astro.props;
const copy = ui[locale];
const t = (key: keyof typeof copy) => copy[key];
const localizedCategory = (category: string) =>
  categoryTranslations[category]?.[locale] ?? category;
const localizedProduct = (product: {
  id: string;
  name: string;
  description: string;
}) =>
  productTranslations[product.id]?.[locale] ??
  productTranslationsExtra[product.id]?.[locale] ??
  product;
const catalogForProduct = (_product: { id: string }) => "principal";
const whatsappForProduct = (product: { id: string }) =>
  whatsappCatalogs[catalogForProduct(product)][locale === "fr" ? "fr" : "es"];
const flagByLocale = {
  es: '<svg viewBox="0 0 24 16" role="img" aria-label="Español"><path fill="#aa151b" d="M0 0h24v16H0z"/><path fill="#f1bf00" d="M0 4h24v8H0z"/></svg>',
  en: '<svg viewBox="0 0 24 16" role="img" aria-label="English"><path fill="#1a3478" d="M0 0h24v16H0z"/><path stroke="#fff" stroke-width="4" d="M0 0l24 16M24 0L0 16"/><path stroke="#c8102e" stroke-width="2" d="M0 0l24 16M24 0L0 16"/><path stroke="#fff" stroke-width="5" d="M12 0v16M0 8h24"/><path stroke="#c8102e" stroke-width="2" d="M12 0v16M0 8h24"/></svg>',
  fr: '<svg viewBox="0 0 24 16" role="img" aria-label="Français"><path fill="#0055a4" d="M0 0h8v16H0z"/><path fill="#fff" d="M8 0h8v16H8z"/><path fill="#ef4135" d="M16 0h8v16h-8z"/></svg>',
} as const;

const visibleCategories = categories;
const featuredProducts = [products[3], products[4], products[6]];
const heroImages = [
  "/images/hero/1.jpeg",
  "/images/hero/2.jpeg",
  "/images/hero/3.jpeg",
  "/images/hero/4.jpeg",
  "/images/hero/5.jpeg",
  "/images/hero/6.jpeg",
  "/images/hero/7.jpeg",
  "/images/hero/8.jpeg",
  "/images/hero/9.jpeg",
];
const clean = (html: string) =>
  html
    .replace(/<[^>]+>/g, " ")
    .replace(/\s+/g, " ")
    .trim();
const excerpt = (html: string) =>
  clean(html).slice(0, 118) + (clean(html).length > 118 ? "…" : "");
const priceLocale =
  locale === "en" ? "en-GB" : locale === "fr" ? "fr-FR" : "es-ES";
const formatPrice = (price: number) =>
  price > 0
    ? (price * 1.21).toLocaleString(priceLocale, {
        style: "currency",
        currency: "EUR",
      })
    : t("ask");
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={t("siteDescription")} />
    <meta name="theme-color" content="#f6f3ed" />
    <title>{t("siteTitle")}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#inicio" aria-label="Evoka, inicio"
        ><img
          class="brand-logo"
          src="/images/brand/logo-transparent-clean.png"
          alt="Evoka"
        /></a
      >
      <nav aria-label="Navegación principal">
        <a href="#seleccion">{t("navSelection")}</a>
        <a href="#catalogo">{t("navCatalog")}</a>
        <a href="#categorias">{t("navCategories")}</a>
      </nav>
      <a class="header-contact" href="#contacto"
        >{t("contact")} <span>↗</span></a
      ><div class="language-select">
        <button
          type="button"
          class="language-current"
          id="language-current"
          aria-expanded="false"
          aria-controls="language-menu"
          ><span class="language-flag" set:html={flagByLocale[locale]} /><span
            >{locale.toUpperCase()}</span
          ><span class="language-chevron">⌄</span></button
        ><div class="language-menu" id="language-menu" hidden>
          {
            ["es", "en", "fr"].map((language) => (
              <a
                href={language === "es" ? "/" : `/${language}/`}
                class:list={{ "is-active": locale === language }}
              >
                <>
                  <span
                    class="language-flag"
                    set:html={
                      flagByLocale[language as keyof typeof flagByLocale]
                    }
                  />
                  <span>{language.toUpperCase()}</span>
                </>
              </a>
            ))
          }
        </div>
      </div>
    </header>

    <main id="inicio">
      <section class="hero wrap">
        <div class="hero-copy">
          <p class="eyebrow">{t("heroEyebrow")}</p>
          <h1>{t("heroTitle")}<br /><em>{t("heroTitleAccent")}</em></h1>
          <p class="hero-text">{t("heroText")}</p>
          <div class="hero-actions">
            <a class="button button-dark" href="#catalogo"
              >{t("catalogButton")} <span>↗</span></a
            ><a
              class="whatsapp-link"
              href="https://wa.me/?text=Hola%2C%20quiero%20contactar%20con%20Evoka"
              target="_blank"
              rel="noreferrer"
              aria-label={t("contactUs")}
              ><svg viewBox="0 0 24 24" aria-hidden="true"
                ><path
                  d="M20.5 3.5A11.8 11.8 0 0 0 12.1 0 11.9 11.9 0 0 0 1.8 17.8L.4 23.6l6-1.4a11.9 11.9 0 0 0 5.7 1.4h.1A11.9 11.9 0 0 0 20.5 3.5Zm-8.3 18.1h-.1a9.9 9.9 0 0 1-5-1.4l-.4-.2-3.6.8 1-3.5-.2-.4a9.9 9.9 0 1 1 8.3 4.7Zm5.4-7.4c-.3-.2-1.8-.9-2.1-1s-.5-.2-.7.2-.8 1-.9 1.2-.3.2-.6.1a8.1 8.1 0 0 1-2.4-1.5 9 9 0 0 1-1.7-2.1c-.2-.3 0-.5.1-.7l.5-.6c.2-.2.2-.4.3-.6s0-.4 0-.5-.7-1.7-1-2.3c-.3-.6-.5-.5-.7-.5h-.6a1.1 1.1 0 0 0-.8.4 3.3 3.3 0 0 0-1 2.5 5.7 5.7 0 0 0 1.2 3.1 13.2 13.2 0 0 0 5 4.4c.7.3 1.2.5 1.6.6a3.9 3.9 0 0 0 1.8.1 3 3 0 0 0 2-1.4 2.4 2.4 0 0 0 .2-1.4c-.1-.1-.3-.2-.5-.3Z"
                ></path></svg
              ><span>{t("contactUs")}</span></a
            >
          </div>
        </div>
        <div class="hero-visual" aria-label="Galería de imágenes Evoka">
          <div class="hero-shape hero-shape-one"></div><div
            class="hero-shape hero-shape-two"
          >
          </div>
          <div class="hero-slides">
            {
              heroImages.map((image, index) => (
                <div
                  class={`hero-slide ${index === 0 ? "is-active" : ""}`}
                  data-hero-slide={index}
                >
                  <img
                    src={image}
                    alt={`Evoka · imagen ${index + 1}`}
                    loading={index === 0 ? "eager" : "lazy"}
                  />
                </div>
              ))
            }
          </div>
          <div class="hero-label">
            <span>EVK / 2026</span><strong
              >{t("heroLabel")}<br /><em>{t("heroLabelAccent")}</em></strong
            >
          </div>
          <div class="hero-controls" aria-label="Controles de la selección">
            <button
              type="button"
              class="hero-control"
              data-hero-prev
              aria-label={t("prev")}>←</button
            >
            <span class="hero-index"
              ><b data-hero-current>01</b>
              <span>/</span>
              {heroImages.length.toString().padStart(2, "0")}</span
            >
            <button
              type="button"
              class="hero-control"
              data-hero-next
              aria-label={t("next")}>→</button
            >
          </div>
        </div>
      </section>

      <section class="promise-band">
        <div class="wrap promise-grid">
          <span class="eyebrow">{t("promiseEyebrow")}</span><h2>
            {t("promiseTitle")}<br /><em>{t("promiseTitleAccent")}</em>
          </h2><p>{t("promiseText")}</p>
        </div>
      </section>

      <section class="section wrap" id="seleccion">
        <div class="section-heading">
          <div>
            <p class="eyebrow">{t("selectionEyebrow")}</p><h2>
              {t("selectionTitle")}
              <em>{t("selectionAccent")}</em>
            </h2>
          </div><span class="section-count"
            >{featuredProducts.length.toString().padStart(2, "0")} / {
              t("favorites")
            }</span
          >
        </div>
        <div class="featured-grid">
          {
            featuredProducts.map((product, index) => (
              <article class={`featured-card featured-${index}`}>
                <a
                  class="featured-image"
                  href={`#product-${product.id}`}
                  data-featured-filter={product.categories[0]}
                >
                  <>
                    <img
                      src={`/images/products/${product.imageIds[0]}.jpg`}
                      alt={localizedProduct(product).name}
                      loading={index > 1 ? "lazy" : "eager"}
                    />
                    <span class="image-index">0{index + 1}</span>
                  </>
                </a>
                <div class="card-meta">
                  <>
                    <div>
                      <>
                        <p class="product-category">
                          {localizedCategory(product.categories[0])}
                        </p>
                        <h3>{localizedProduct(product).name}</h3>
                      </>
                    </div>
                    <strong>{formatPrice(product.price)}</strong>
                  </>
                </div>
                <p class="card-description">
                  {excerpt(localizedProduct(product).description)}
                </p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="catalog-section" id="catalogo">
        <div class="catalog-intro">
          <div class="wrap">
            <div class="section-heading catalog-heading">
              <div>
                <p class="eyebrow">{t("catalogEyebrow")}</p><h2>
                  {t("catalogTitle")}
                </h2>
              </div><p class="catalog-note">
                {products.length}
                {t("products")}<br />{
                  t("productsReady")
                    .split("\\n")
                    .map((line) => (
                      <>
                        {line}
                        <br />
                      </>
                    ))
                }
              </p>
            </div>
            <div class="catalog-toolbar">
              <label class="search-box"
                ><span>⌕</span><input
                  id="product-search"
                  type="search"
                  placeholder={t("searchPlaceholder")}
                  aria-label={t("searchPlaceholder")}
                /></label
              ><div class="filter-navigation">
                <button
                  type="button"
                  class="filter-arrow"
                  data-filter-scroll="-1"
                  aria-label={t("left")}>←</button
                ><div
                  class="filter-list"
                  role="group"
                  aria-label={t("filterAria")}
                >
                  {
                    visibleCategories.map((category) => (
                      <button
                        class="filter-button"
                        data-filter={category}
                        aria-pressed="false"
                      >
                        {localizedCategory(category)}
                      </button>
                    ))
                  }
                </div><button
                  type="button"
                  class="filter-arrow"
                  data-filter-scroll="1"
                  aria-label={t("right")}>→</button
                >
              </div>
            </div>
          </div>
        </div>
        <div class="wrap">
          <div class="catalog-grid" id="product-grid">
            {
              products.map((product) => (
                <article
                  class="catalog-card"
                  id={`product-${product.id}`}
                  data-name={`${localizedProduct(product).name} ${product.categories.join(" ")}`.toLowerCase()}
                  data-categories={product.categories.join("|")}
                >
                  <a class="catalog-image" href={`#product-${product.id}`}>
                    <>
                      <img
                        src={`/images/products/${product.imageIds[0]}.jpg`}
                        alt={localizedProduct(product).name}
                        loading="lazy"
                      />
                      <span class="stock-badge">
                        {product.stock > 0 ? t("available") : t("ask")}
                      </span>
                    </>
                  </a>
                  <div class="catalog-card-body">
                    <>
                      <p class="product-category">
                        {localizedCategory(product.categories[0])}
                      </p>
                      <div class="catalog-title-row">
                        <>
                          <h3>{localizedProduct(product).name}</h3>
                          <strong>{formatPrice(product.price)}</strong>
                        </>
                      </div>
                      <p class="catalog-excerpt">
                        {excerpt(localizedProduct(product).description)}
                      </p>
                      <div class="catalog-links">
                        <>
                          <a
                            href={whatsappForProduct(product)}
                            target="_blank"
                            rel="noreferrer"
                          >
                            {t("whatsapp")} <span>↗</span>
                          </a>
                          <button
                            type="button"
                            class="details-trigger"
                            data-details-name={localizedProduct(product).name}
                            data-details-price={formatPrice(product.price)}
                            data-details-image={`/images/products/${product.imageIds[0]}.jpg`}
                            data-details-description={
                              localizedProduct(product).description
                            }
                          >
                            {t("details")} <span>→</span>
                          </button>
                        </>
                      </div>
                    </>
                  </div>
                </article>
              ))
            }
          </div>
          <p class="empty-state" id="empty-state" hidden>{t("empty")}</p>
        </div>
      </section>

      <section class="section wrap categories-section" id="categorias">
        <div class="section-heading">
          <div>
            <p class="eyebrow">{t("categoriesEyebrow")}</p><h2>
              {t("categoriesTitle")}
              <em>{t("categoriesAccent")}</em>
            </h2>
          </div>
        </div><div class="category-list">
          {
            visibleCategories.map((category, index) => (
              <button
                class={`category-row tone-${index % 3}`}
                data-filter-link={category}
              >
                <>
                  <span>0{index + 1}</span>
                  <h3>{localizedCategory(category)}</h3>
                  <small>
                    {
                      products.filter((product) =>
                        product.categories.includes(category),
                      ).length
                    }{" "}
                    {t("products")}
                  </small>
                  <b>↗</b>
                </>
              </button>
            ))
          }
        </div>
      </section>
    </main>

    <footer id="contacto">
      <div class="wrap footer-top">
        <div>
          <a class="brand brand-light" href="#inicio"
            ><img
              class="brand-logo-footer footer-brand-logo"
              src="/images/brand/logo-transparent-clean.png"
              alt="Evoka"
            /></a
          ><p>
            {
              t("footerTagline")
                .split("\\n")
                .map((line) => (
                  <>
                    {line}
                    <br />
                  </>
                ))
            }
          </p>
        </div><div>
          <p class="eyebrow">{t("footerBuyEyebrow")}</p><p>
            {
              t("footerBuy")
                .split("\\n")
                .map((line) => (
                  <>
                    {line}
                    <br />
                  </>
                ))
            }
          </p>
        </div><div>
          <p class="eyebrow">{t("footerContact")}</p><a
            href="mailto:deco-evoka@hotmail.com">deco-evoka@hotmail.com</a
          ><p>{t("footerReply")}</p><div class="social-links">
            <a
              href="https://www.instagram.com/evoka_deco/"
              target="_blank"
              rel="noreferrer"
              ><svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true"
                ><rect
                  x="3"
                  y="3"
                  width="18"
                  height="18"
                  rx="5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"></rect><circle
                  cx="12"
                  cy="12"
                  r="4.2"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"></circle><circle
                  cx="17.5"
                  cy="6.5"
                  r="1.2"
                  fill="currentColor"></circle></svg
              ><span>Instagram ↗</span></a
            ><a
              href="https://www.facebook.com/profile.php?id=61576576741857"
              target="_blank"
              rel="noreferrer"
              ><svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true"
                ><path
                  fill="currentColor"
                  d="M14 8h3V4h-3c-3.3 0-5 2-5 5v3H6v4h3v4h4v-4h3.2l.8-4H13V9c0-.7.3-1 1-1Z"
                ></path></svg
              ><span>Facebook ↗</span></a
            ><a
              href="https://www.tiktok.com/@evoka_deco0"
              target="_blank"
              rel="noreferrer"
              ><svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true"
                ><path
                  fill="currentColor"
                  d="M15 4c.3 1.9 1.4 3.2 3.5 3.5v3.2c-1.4-.1-2.6-.5-3.5-1.2v6.1a5.4 5.4 0 1 1-4.7-5.3v3.3a2.2 2.2 0 1 0 1.5 2V4H15Z"
                ></path></svg
              ><span>TikTok ↗</span></a
            ><a
              href="https://www.vinted.es/member/3138307263-evoka-decomur"
              target="_blank"
              rel="noreferrer"
              ><svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true"
                ><path
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="m4 5 8 14 8-14M7.2 5h9.6"></path></svg
              ><span>Vinted ↗</span></a
            >
          </div>
        </div>
      </div><div class="wrap secure-payment-strip">
        <div class="secure-payment-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M12 3 19 6v5c0 4.6-2.8 8.1-7 10-4.2-1.9-7-5.4-7-10V6l7-3Z"></path>
            <path d="m9 12 2 2 4-5"></path>
          </svg>
        </div><div class="secure-payment-strip-copy">
          <p class="eyebrow">{t("securePaymentEyebrow")}</p>
          <h2>{t("securePayment")}</h2>
          <p>{t("securePaymentIntro")}</p>
        </div><button
          type="button"
          class="secure-payment-trigger"
          id="secure-payment-trigger"
          aria-haspopup="dialog"
          aria-controls="secure-payment-modal"
        >{t("securePaymentMore")} <span aria-hidden="true">↗</span></button>
      </div><div class="wrap footer-bottom">
        <span>© 2026 Evoka</span><span>{t("footerMade")}</span>
      </div>
    </footer>

    <dialog
      class="product-modal"
      id="product-modal"
      aria-labelledby="modal-product-title"
    >
      <div class="product-modal-panel">
        <button
          type="button"
          class="product-modal-close"
          id="product-modal-close"
          aria-label={t("close")}>×</button
        >
        <div class="product-modal-layout">
          <div class="product-modal-image">
            <img id="modal-product-image" src="" alt="" />
          </div>
          <div class="product-modal-copy">
            <p class="eyebrow">{t("viewProduct")}</p><div
              class="modal-title-row"
            >
              <h2 id="modal-product-title"></h2><strong id="modal-product-price"
              ></strong>
            </div><div
              class="modal-product-description"
              id="modal-product-description"
            >
            </div><a
              class="button button-dark modal-whatsapp"
              id="modal-product-whatsapp"
              href="#"
              target="_blank"
              rel="noreferrer">{t("whatsapp")} <span>↗</span></a
            >
          </div>
        </div>
      </div>
    </dialog>
    <dialog
      class="product-modal secure-payment-modal"
      id="secure-payment-modal"
      aria-labelledby="secure-payment-title"
    >
      <div class="product-modal-panel secure-payment-panel">
        <button
          type="button"
          class="product-modal-close"
          id="secure-payment-close"
          aria-label={t("close")}>×</button
        >
        <div class="secure-payment-copy">
          <p class="eyebrow">{t("securePaymentEyebrow")}</p>
          <h2 id="secure-payment-title">{t("securePaymentTitle")}</h2>
          <p class="secure-payment-summary">{t("securePaymentSummary")}</p>
          <h3>{t("securePaymentMethods")}</h3>
          <div class="secure-payment-methods">
            <div>
              <strong>{t("securePaymentBizum")}</strong>
              <p>{t("securePaymentBizumText")}</p>
            </div><div>
              <strong>{t("securePaymentBank")}</strong>
              <p>{t("securePaymentBankText")}</p>
            </div><div>
              <strong>{t("securePaymentRevolut")}</strong>
              <p>{t("securePaymentRevolutText")}</p>
            </div>
          </div>
          <div class="secure-payment-about">
            <h3>{t("securePaymentAbout")}</h3>
            <p>{t("securePaymentAboutText")}</p>
          </div>
        </div>
      </div>
    </dialog>
    <script>
      const productModal = document.querySelector("#product-modal");
      const productModalClose = document.querySelector("#product-modal-close");
      const modalImage = document.querySelector("#modal-product-image");
      const modalTitle = document.querySelector("#modal-product-title");
      const modalPrice = document.querySelector("#modal-product-price");
      const modalDescription = document.querySelector(
        "#modal-product-description",
      );
      const modalWhatsapp = document.querySelector("#modal-product-whatsapp");
      const detailTriggers = [...document.querySelectorAll(".details-trigger")];
      const openProductModal = (trigger) => {
        modalImage.src = trigger.dataset.detailsImage;
        modalImage.alt = trigger.dataset.detailsName;
        modalTitle.textContent = trigger.dataset.detailsName;
        modalPrice.textContent = trigger.dataset.detailsPrice;
        modalDescription.innerHTML = trigger.dataset.detailsDescription;
        modalWhatsapp.href =
          trigger
            .closest(".catalog-card")
            ?.querySelector(".catalog-links a:first-child")?.href || "#";
        productModal.showModal();
      };
      detailTriggers.forEach((trigger) =>
        trigger.addEventListener("click", () => openProductModal(trigger)),
      );
      productModalClose.addEventListener("click", () => productModal.close());
      productModal.addEventListener("click", (event) => {
        if (event.target === productModal) productModal.close();
      });
      const securePaymentModal = document.querySelector(
        "#secure-payment-modal",
      );
      const securePaymentTrigger = document.querySelector(
        "#secure-payment-trigger",
      );
      const securePaymentClose = document.querySelector(
        "#secure-payment-close",
      );
      securePaymentTrigger.addEventListener("click", () =>
        securePaymentModal.showModal(),
      );
      securePaymentClose.addEventListener("click", () =>
        securePaymentModal.close(),
      );
      securePaymentModal.addEventListener("click", (event) => {
        if (event.target === securePaymentModal) securePaymentModal.close();
      });
      const languageCurrent = document.querySelector("#language-current");
      const languageMenu = document.querySelector("#language-menu");
      languageCurrent.addEventListener("click", () => {
        const isOpen = languageCurrent.getAttribute("aria-expanded") === "true";
        languageCurrent.setAttribute("aria-expanded", String(!isOpen));
        languageMenu.hidden = isOpen;
      });
      document.addEventListener("click", (event) => {
        if (!event.target.closest(".language-select")) {
          languageCurrent.setAttribute("aria-expanded", "false");
          languageMenu.hidden = true;
        }
      });

      const search = document.querySelector("#product-search");
      const heroSlides = [...document.querySelectorAll("[data-hero-slide]")];
      const heroCurrent = document.querySelector("[data-hero-current]");
      const heroPrev = document.querySelector("[data-hero-prev]");
      const heroNext = document.querySelector("[data-hero-next]");
      let heroIndex = 0;
      let heroTimer;
      const showHeroSlide = (nextIndex) => {
        heroIndex = (nextIndex + heroSlides.length) % heroSlides.length;
        heroSlides.forEach((slide, index) =>
          slide.classList.toggle("is-active", index === heroIndex),
        );
        heroCurrent.textContent = String(heroIndex + 1).padStart(2, "0");
      };
      const restartHeroTimer = () => {
        window.clearInterval(heroTimer);
        heroTimer = window.setInterval(
          () => showHeroSlide(heroIndex + 1),
          5000,
        );
      };
      heroPrev.addEventListener("click", () => {
        showHeroSlide(heroIndex - 1);
        restartHeroTimer();
      });
      heroNext.addEventListener("click", () => {
        showHeroSlide(heroIndex + 1);
        restartHeroTimer();
      });
      restartHeroTimer();
      const buttons = [...document.querySelectorAll("[data-filter]")];
      const filterList = document.querySelector(".filter-list");
      const filterArrows = [
        ...document.querySelectorAll("[data-filter-scroll]"),
      ];
      const updateFilterArrows = () => {
        const maxScroll = filterList.scrollWidth - filterList.clientWidth;
        filterArrows[0].disabled = filterList.scrollLeft <= 1;
        filterArrows[1].disabled = filterList.scrollLeft >= maxScroll - 1;
      };
      filterArrows.forEach((arrow) =>
        arrow.addEventListener("click", () => {
          filterList.scrollBy({
            left: Number(arrow.dataset.filterScroll) * 190,
            behavior: "smooth",
          });
        }),
      );
      filterList.addEventListener("scroll", updateFilterArrows, {
        passive: true,
      });
      window.addEventListener("resize", updateFilterArrows);
      filterList.scrollLeft = 0;
      window.setTimeout(updateFilterArrows, 0);
      const cards = [...document.querySelectorAll(".catalog-card")];
      const empty = document.querySelector("#empty-state");
      const featuredLinks = [
        ...document.querySelectorAll('.featured-image[href^="#product-"]'),
      ];

      const highlightProduct = (id, updateHash = true) => {
        const product = document.querySelector(id);
        if (!product) return;
        document
          .querySelectorAll(".catalog-card.is-highlighted")
          .forEach((card) => card.classList.remove("is-highlighted"));
        void product.offsetWidth;
        product.classList.add("is-highlighted");
        product.scrollIntoView({ behavior: "smooth", block: "center" });
        if (updateHash) history.replaceState(null, "", id);
        window.setTimeout(
          () => product.classList.remove("is-highlighted"),
          1200,
        );
      };

      featuredLinks.forEach((link) =>
        link.addEventListener("click", (event) => {
          event.preventDefault();
          search.value = "";
          const filterButton = buttons.find(
            (button) => button.dataset.filter === link.dataset.featuredFilter,
          );
          if (filterButton && !filterButton.classList.contains("is-active"))
            filterButton.click();
          update();
          highlightProduct(link.getAttribute("href"));
        }),
      );
      let activeFilter = "all";
      const update = () => {
        const query = search.value.toLowerCase().trim();
        let visible = 0;
        cards.forEach((card) => {
          const matchesQuery = card.dataset.name.includes(query);
          const matchesFilter =
            activeFilter === "all" ||
            card.dataset.categories.split("|").includes(activeFilter);
          const show = matchesQuery && matchesFilter;
          card.hidden = !show;
          if (show) visible++;
        });
        empty.hidden = visible !== 0;
      };
      buttons.forEach((button) =>
        button.addEventListener("click", () => {
          const wasActive = button.classList.contains("is-active");
          activeFilter = wasActive ? "all" : button.dataset.filter;
          buttons.forEach((item) => {
            const selected = activeFilter !== "all" && item === button;
            item.classList.toggle("is-active", selected);
            item.setAttribute("aria-pressed", String(selected));
          });
          update();
          if (!wasActive) {
            const targetScroll =
              button.offsetLeft -
              (filterList.clientWidth - button.offsetWidth) / 2;
            filterList.scrollTo({
              left: Math.max(
                0,
                Math.min(
                  targetScroll,
                  filterList.scrollWidth - filterList.clientWidth,
                ),
              ),
              behavior: "smooth",
            });
          }
        }),
      );
      document.querySelectorAll("[data-filter-link]").forEach((link) =>
        link.addEventListener("click", () => {
          const button = buttons.find(
            (item) => item.dataset.filter === link.dataset.filterLink,
          );
          button?.click();
          document
            .querySelector("#catalogo")
            .scrollIntoView({ behavior: "smooth" });
        }),
      );
      search.addEventListener("input", update);
    </script>
  </body>
</html>
