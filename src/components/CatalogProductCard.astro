---
import {
  excerpt,
  formatPrice,
  localizedCategory,
  localizedProduct,
  productImageUrl,
  productDetailUrl,
  translate,
  whatsappForProduct,
  type Locale,
} from "../lib/catalog-view";
import { catalogProductNames } from "../i18n/ui";
import { catalogShortDescriptions } from "../data/catalog-short-descriptions";
import type { Product } from "../data/catalog";
import ResponsiveProductImage from "./ResponsiveProductImage.astro";

interface Props {
  locale: Locale;
  product: Product;
  index: number;
}

const { locale, product, index } = Astro.props;
const productCopy = localizedProduct(locale, product);
const localized = {
  ...productCopy,
  name: catalogProductNames[product.id]?.[locale] ?? productCopy.name,
};
---

<article
  class="catalog-card"
  id={`product-${product.id}`}
  data-catalog-index={index}
  data-name={`${localized.name} ${productCopy.name} ${product.categories.join(" ")}`.toLowerCase()}
  data-categories={product.categories.join("|")}
>
  <button
    type="button"
    class="catalog-image image-modal-trigger"
    aria-label={`${translate(locale, "viewProduct")}: ${localized.name}`}
    data-details-name={localized.name}
    data-details-price={formatPrice(locale, product.price)}
    data-details-image={productImageUrl(product.imageIds[0], "jpg")}
    data-details-image-avif={productImageUrl(product.imageIds[0], "avif", 1200)}
    data-details-image-webp={productImageUrl(product.imageIds[0], "webp", 1200)}
    data-details-description={localized.description}
    data-details-whatsapp={whatsappForProduct(locale, product)}
  >
    <ResponsiveProductImage
      imageId={product.imageIds[0]}
      alt={localized.name}
    />
    <span class="stock-badge">
      {
        product.stock > 0
          ? translate(locale, "available")
          : translate(locale, "soldout")
      }
    </span>
  </button>
  <div class="catalog-card-body">
    <p class="product-category">
      {localizedCategory(locale, product.categories[0])}
    </p>
    <div class="catalog-title-row">
      <h3>{localized.name}</h3>
      <strong>{formatPrice(locale, product.price)}</strong>
    </div>
    <p class="catalog-excerpt">{catalogShortDescriptions[product.id]?.[locale] ?? excerpt(localized.description)}</p>
    <div class="catalog-links">
      <a
        href={whatsappForProduct(locale, product)}
        target="_blank"
        rel="noreferrer"
      >
        {translate(locale, "whatsapp")}
      </a>
      <a class="details-trigger" href={productDetailUrl(locale, product)}>
        {translate(locale, "catalogDiscover")}
      </a>
    </div>
  </div>
</article>

<style>
  /* Local to catalog information; category, photograph and badge keep their styles. */
  .catalog-card-body .catalog-title-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    column-gap: 20px;
    min-width: 0;
    min-height: 0;
  }

  .catalog-card-body .catalog-title-row h3 {
    min-width: 0;
    margin: 0;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .catalog-card-body .catalog-title-row strong {
    justify-self: end;
    margin: 0;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
    white-space: nowrap;
  }

  .catalog-card-body .catalog-excerpt {
    max-width: none;
    margin: 12px 0 0;
    font-size: 13px;
    line-height: 1.65;
    min-height: 0;
    display: block;
    -webkit-line-clamp: unset;
    overflow: visible;
    overflow-wrap: anywhere;
  }

  .catalog-card-body .catalog-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 22px;
    margin-top: 8px;
  }

  .catalog-card-body .catalog-links a {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    margin-top: 0;
    font: 500 13px/1.4 'DM Sans', sans-serif;
    color: var(--evoka);
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    flex: 0 0 auto;
    justify-content: center;
    padding: 3px 12px;
    border: 1px solid rgba(110, 79, 55, 0.18);
    border-radius: 999px;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.24), rgba(255, 248, 238, 0.08));
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.45), 0 1px 3px rgba(46, 24, 10, 0.05);
    text-decoration: none;
    white-space: nowrap;
  }

  .catalog-card-body .catalog-links a:focus-visible {
    outline: 2px solid var(--evoka);
    outline-offset: 3px;
    border-color: rgba(110, 79, 55, 0.35);
  }

  @media (hover: hover) and (pointer: fine) {
    .catalog-card-body .catalog-links a:hover {
      text-decoration-thickness: 2px;
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.34), rgba(255, 248, 238, 0.14));
      border-color: rgba(110, 79, 55, 0.26);
    }
  }

  .catalog-card-body .catalog-links a:active {
    background: rgba(255, 248, 238, 0.12);
    box-shadow: inset 0 1px 2px rgba(46, 24, 10, 0.08);
  }

  /* Each card follows its own content height, independently of adjacent cards. */
  .catalog-card {
    min-width: 0;
    align-self: start;
  }

  /* Stretch only within each multicolumn row; keep text at its natural height. */
  @media (min-width: 441px) {
    .catalog-card {
      display: grid;
      grid-template-rows: auto 1fr;
      align-self: stretch;
    }

    .catalog-card[hidden] {
      display: none;
    }

    .catalog-card-body {
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    .catalog-card-body .catalog-links {
      margin-top: auto;
      padding-top: 8px;
    }
  }

  @media (max-width: 620px) {
    .catalog-card-body .catalog-links {
      gap: 4px 16px;
    }
  }
</style>
