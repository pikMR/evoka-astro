---
import {
  excerpt,
  featuredProducts,
  formatPrice,
  localizedCategory,
  localizedProduct,
  productDetailUrl,
  productImageUrl,
  translate,
  whatsappForProduct,
  type Locale,
} from "../lib/catalog-view";
import ResponsiveProductImage from "./ResponsiveProductImage.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = (key: Parameters<typeof translate>[1]) => translate(locale, key);
---

<section class="section wrap" id="seleccion">
  <div class="section-heading">
    <div>
      <p class="eyebrow">{t("selectionEyebrow")}</p><h2>
        {t("selectionTitle")}
        <em>{t("selectionAccent")}</em>
      </h2>
    </div><span class="section-count"
      >{featuredProducts.length.toString().padStart(2, "0")} / {
        t("favorites")
      }</span
    >
  </div>
  <div class="featured-grid">
    {
      featuredProducts.map((product, index) => (
        <article class={`featured-card featured-${index}`}>
          <button
            type="button"
            class="featured-image image-modal-trigger"
            aria-label={`${t("viewProduct")}: ${localizedProduct(locale, product).name}`}
            data-details-name={localizedProduct(locale, product).name}
            data-details-price={formatPrice(locale, product.price)}
            data-details-image={productImageUrl(product.imageIds[0], "jpg")}
            data-details-image-avif={productImageUrl(product.imageIds[0], "avif", 1200)}
            data-details-image-webp={productImageUrl(product.imageIds[0], "webp", 1200)}
            data-details-description={localizedProduct(locale, product).description}
            data-details-whatsapp={whatsappForProduct(locale, product)}
          >
            <ResponsiveProductImage
              imageId={product.imageIds[0]}
              alt={localizedProduct(locale, product).name}
              loading={index > 1 ? "lazy" : "eager"}
            />
            <span class="image-index">0{index + 1}</span>
          </button>
          <div class="card-meta">
            <div>
              <p class="product-category">
                {localizedCategory(locale, product.categories[0])}
              </p>
              <h3>{localizedProduct(locale, product).name}</h3>
            </div>
            <strong>{formatPrice(locale, product.price)}</strong>
          </div>
          <p class="card-description">
            {excerpt(localizedProduct(locale, product).description)}
          </p>
        </article>
      ))
    }
  </div>
</section>
