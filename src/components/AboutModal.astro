---
import { aboutContent } from "../config/site";
import { translate, type Locale } from "../lib/catalog-view";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = (key: Parameters<typeof translate>[1]) => translate(locale, key);
const content = aboutContent[locale];
---

<dialog
  class="product-modal about-modal"
  id="about-modal"
  aria-labelledby="about-modal-title"
>
  <div class="product-modal-panel about-modal-panel">
    <button
      type="button"
      class="product-modal-close"
      id="about-modal-close"
      aria-label={t("close")}>×</button
    >
    <div class="about-modal-copy">
      <p class="eyebrow">{t("footerAboutEyebrow")}</p>
      <h2 id="about-modal-title">{content.title}</h2>
      <div class="about-intro-layout">
        <div class="about-intro">
          {content.intro.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <img
          class="about-modal-image"
          src="/images/about/puente.jpeg"
          alt={t("footerAboutImageAlt")}
          loading="lazy"
        />
      </div>
      <h3>{content.faqTitle}</h3>
      <div class="about-faq-list">
        {
          content.faqs.map(([question, answer]) => (
            <details>
              <summary>{question}</summary>
              <p>{answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</dialog>

<script>
  const aboutModal = document.querySelector<HTMLDialogElement>("#about-modal")!;
  const aboutTrigger = document.querySelector<HTMLButtonElement>(
    "#about-modal-trigger",
  )!;
  const aboutClose = document.querySelector<HTMLButtonElement>(
    "#about-modal-close",
  )!;

  aboutTrigger.addEventListener("click", () => aboutModal.showModal());
  aboutClose.addEventListener("click", () => aboutModal.close());
  aboutModal.addEventListener("click", (event) => {
    if (event.target === aboutModal) aboutModal.close();
  });
</script>
