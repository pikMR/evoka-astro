---
import { categories, products } from '../data/catalog';
import '../styles/global.css';

const visibleCategories = categories;
const featuredProducts = products.slice(3, 6);
const clean = (html: string) => html.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
const excerpt = (html: string) => clean(html).slice(0, 118) + (clean(html).length > 118 ? '…' : '');
const formatPrice = (price: number) => price > 0 ? (price * 1.21).toLocaleString('es-ES', { style: 'currency', currency: 'EUR' }) : 'Consultar';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Evoka: regalos, detalles y piezas con personalidad para celebrar lo que importa." />
    <meta name="theme-color" content="#f6f3ed" />
    <title>Evoka · Regalos con personalidad</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#inicio" aria-label="Evoka, inicio">evoka<span>.</span></a>
      <nav aria-label="Navegación principal">
        <a href="#seleccion">Selección</a>
        <a href="#catalogo">Catálogo</a>
        <a href="#categorias">Categorías</a>
      </nav>
      <a class="header-contact" href="#contacto">Hablemos <span>↗</span></a>
    </header>

    <main id="inicio">
      <section class="hero wrap">
        <div class="hero-copy">
          <p class="eyebrow">Regalos que cuentan algo</p>
          <h1>Pequeñas cosas.<br /><em>Grandes momentos.</em></h1>
          <p class="hero-text">Una selección de regalos, detalles y piezas especiales para celebrar, sorprender y hacerte sonreír.</p>
          <div class="hero-actions"><a class="button button-dark" href="#catalogo">Ver catálogo <span>↗</span></a><a class="whatsapp-link" href="https://wa.me/?text=Hola%2C%20quiero%20contactar%20con%20Evoka" target="_blank" rel="noreferrer" aria-label="Contáctanos por WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 3.5A11.8 11.8 0 0 0 12.1 0 11.9 11.9 0 0 0 1.8 17.8L.4 23.6l6-1.4a11.9 11.9 0 0 0 5.7 1.4h.1A11.9 11.9 0 0 0 20.5 3.5Zm-8.3 18.1h-.1a9.9 9.9 0 0 1-5-1.4l-.4-.2-3.6.8 1-3.5-.2-.4a9.9 9.9 0 1 1 8.3 4.7Zm5.4-7.4c-.3-.2-1.8-.9-2.1-1s-.5-.2-.7.2-.8 1-.9 1.2-.3.2-.6.1a8.1 8.1 0 0 1-2.4-1.5 9 9 0 0 1-1.7-2.1c-.2-.3 0-.5.1-.7l.5-.6c.2-.2.2-.4.3-.6s0-.4 0-.5-.7-1.7-1-2.3c-.3-.6-.5-.5-.7-.5h-.6a1.1 1.1 0 0 0-.8.4 3.3 3.3 0 0 0-1 2.5 5.7 5.7 0 0 0 1.2 3.1 13.2 13.2 0 0 0 5 4.4c.7.3 1.2.5 1.6.6a3.9 3.9 0 0 0 1.8.1 3 3 0 0 0 2-1.4 2.4 2.4 0 0 0 .2-1.4c-.1-.1-.3-.2-.5-.3Z"/></svg><span>Contáctanos</span></a></div>
        </div>
        <div class="hero-visual" aria-label="Selección de productos Evoka">
          <div class="hero-shape hero-shape-one"></div><div class="hero-shape hero-shape-two"></div>
          <div class="hero-slides">
            {featuredProducts.map((product, index) => (
              <a class={`hero-slide ${index === 0 ? 'is-active' : ''}`} href={`#product-${product.id}`} data-hero-slide={index} data-featured-filter={product.categories[0]} aria-label={`Ver ${product.name}`}>
                <img src={`/images/products/${product.imageIds[0]}.jpg`} alt={product.name} loading={index === 0 ? 'eager' : 'lazy'} />
                <span class="hero-slide-caption"><small>{product.categories[0]}</small>{product.name}</span>
              </a>
            ))}
          </div>
          <div class="hero-label"><span>EVK / 2026</span><strong>elige<br /><em>bonito</em></strong></div>
          <div class="hero-controls" aria-label="Controles de la selección">
            <button type="button" class="hero-control" data-hero-prev aria-label="Imagen anterior">←</button>
            <span class="hero-index"><b data-hero-current>01</b> <span>/</span> {featuredProducts.length.toString().padStart(2, '0')}</span>
            <button type="button" class="hero-control" data-hero-next aria-label="Imagen siguiente">→</button>
          </div>
        </div>
      </section>

      <section class="promise-band"><div class="wrap promise-grid"><span class="eyebrow">Nuestra forma de elegir</span><h2>Lo especial no siempre<br /><em>hace mucho ruido.</em></h2><p>Buscamos piezas con personalidad, regalos que se recuerdan y detalles que transforman un día cualquiera.</p></div></section>

      <section class="section wrap" id="seleccion">
        <div class="section-heading"><div><p class="eyebrow">Para empezar por aquí</p><h2>La selección <em>Evoka</em></h2></div><span class="section-count">{featuredProducts.length.toString().padStart(2, '0')} / favoritos</span></div>
        <div class="featured-grid">
          {featuredProducts.map((product, index) => (
            <article class={`featured-card featured-${index}`}>
              <a class="featured-image" href={`#product-${product.id}`} data-featured-filter={product.categories[0]}><img src={`/images/products/${product.imageIds[0]}.jpg`} alt={product.name} loading={index > 1 ? 'lazy' : 'eager'} /><span class="image-index">0{index + 1}</span></a>
              <div class="card-meta"><div><p class="product-category">{product.categories[0]}</p><h3>{product.name}</h3></div><strong>{formatPrice(product.price)}</strong></div>
              <p class="card-description">{excerpt(product.description)}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="catalog-section" id="catalogo">
        <div class="wrap">
          <div class="section-heading catalog-heading"><div><p class="eyebrow">Todo lo que hemos reunido</p><h2>El catálogo</h2></div><p class="catalog-note">{products.length} productos<br />listos para descubrir</p></div>
          <div class="catalog-toolbar"><label class="search-box"><span>⌕</span><input id="product-search" type="search" placeholder="Buscar un producto" aria-label="Buscar un producto" /></label><div class="filter-navigation"><button type="button" class="filter-arrow" data-filter-scroll="-1" aria-label="Desplazar categorías hacia la izquierda">←</button><div class="filter-list" role="group" aria-label="Filtrar por categoría">{visibleCategories.map((category) => <button class="filter-button" data-filter={category} aria-pressed="false">{category}</button>)}</div><button type="button" class="filter-arrow" data-filter-scroll="1" aria-label="Desplazar categorías hacia la derecha">→</button></div></div>
          <div class="catalog-grid" id="product-grid">
            {products.map((product) => (
              <article class="catalog-card" id={`product-${product.id}`} data-name={`${product.name} ${product.categories.join(' ')}`.toLowerCase()} data-categories={product.categories.join('|')}>
                <a class="catalog-image" href={`#product-${product.id}`}><img src={`/images/products/${product.imageIds[0]}.jpg`} alt={product.name} loading="lazy" /><span class="stock-badge">{product.stock > 0 ? 'Disponible' : 'Consultar'}</span></a>
                <div class="catalog-card-body"><p class="product-category">{product.categories[0]}</p><div class="catalog-title-row"><h3>{product.name}</h3><strong>{formatPrice(product.price)}</strong></div><p class="catalog-excerpt">{excerpt(product.description)}</p><div class="catalog-links"><a href={`https://wa.me/?text=${encodeURIComponent(`Hola, me interesa ${product.name}`)}`} target="_blank" rel="noreferrer">WhatsApp <span>↗</span></a><a href="#contacto">Más detalles <span>→</span></a></div></div>
              </article>
            ))}
          </div>
          <p class="empty-state" id="empty-state" hidden>No hemos encontrado productos con esa búsqueda.</p>
        </div>
      </section>

      <section class="section wrap categories-section" id="categorias"><div class="section-heading"><div><p class="eyebrow">Encuentra tu próximo favorito</p><h2>Explora por <em>categoría</em></h2></div></div><div class="category-list">{visibleCategories.map((category, index) => <button class={`category-row tone-${index % 3}`} data-filter-link={category}><span>0{index + 1}</span><h3>{category}</h3><small>{products.filter((product) => product.categories.includes(category)).length} productos</small><b>↗</b></button>)}</div></section>
    </main>

    <footer id="contacto"><div class="wrap footer-top"><div><a class="brand brand-light" href="#inicio">evoka<span>.</span></a><p>Una selección con personalidad<br />para regalar y regalarte.</p></div><div><p class="eyebrow">Compra como prefieras</p><p>Muy pronto: compra directa.<br />También estamos en WhatsApp y Vinted.</p></div><div><p class="eyebrow">Contacto</p><a href="mailto:hola@evoka.es">hola@evoka.es</a><p>Respondemos con calma.</p></div></div><div class="wrap footer-bottom"><span>© 2026 Evoka</span><span>Hecho con intención</span></div></footer>

    <script>
      const search = document.querySelector('#product-search');
      const heroSlides = [...document.querySelectorAll('[data-hero-slide]')];
      const heroCurrent = document.querySelector('[data-hero-current]');
      const heroPrev = document.querySelector('[data-hero-prev]');
      const heroNext = document.querySelector('[data-hero-next]');
      let heroIndex = 0;
      let heroTimer;
      const showHeroSlide = (nextIndex) => {
        heroIndex = (nextIndex + heroSlides.length) % heroSlides.length;
        heroSlides.forEach((slide, index) => slide.classList.toggle('is-active', index === heroIndex));
        heroCurrent.textContent = String(heroIndex + 1).padStart(2, '0');
      };
      const restartHeroTimer = () => {
        window.clearInterval(heroTimer);
        heroTimer = window.setInterval(() => showHeroSlide(heroIndex + 1), 5000);
      };
      heroPrev.addEventListener('click', () => { showHeroSlide(heroIndex - 1); restartHeroTimer(); });
      heroNext.addEventListener('click', () => { showHeroSlide(heroIndex + 1); restartHeroTimer(); });
      heroSlides.forEach((slide, index) => slide.addEventListener('click', (event) => {
        if (index !== heroIndex) { event.preventDefault(); showHeroSlide(index); restartHeroTimer(); }
      }));
      restartHeroTimer();
      const buttons = [...document.querySelectorAll('[data-filter]')];
      const filterList = document.querySelector('.filter-list');
      const filterArrows = [...document.querySelectorAll('[data-filter-scroll]')];
      const updateFilterArrows = () => {
        const maxScroll = filterList.scrollWidth - filterList.clientWidth;
        filterArrows[0].disabled = filterList.scrollLeft <= 1;
        filterArrows[1].disabled = filterList.scrollLeft >= maxScroll - 1;
      };
      filterArrows.forEach((arrow) => arrow.addEventListener('click', () => {
        filterList.scrollBy({ left: Number(arrow.dataset.filterScroll) * 190, behavior: 'smooth' });
      }));
      filterList.addEventListener('scroll', updateFilterArrows, { passive: true });
      window.addEventListener('resize', updateFilterArrows);
      window.setTimeout(updateFilterArrows, 0);
      const cards = [...document.querySelectorAll('.catalog-card')];
      const empty = document.querySelector('#empty-state');
      const featuredLinks = [...document.querySelectorAll('.featured-image[href^="#product-"]')];

      const highlightProduct = (id, updateHash = true) => {
        const product = document.querySelector(id);
        if (!product) return;
        document.querySelectorAll('.catalog-card.is-highlighted').forEach((card) => card.classList.remove('is-highlighted'));
        void product.offsetWidth;
        product.classList.add('is-highlighted');
        product.scrollIntoView({ behavior: 'smooth', block: 'center' });
        if (updateHash) history.replaceState(null, '', id);
        window.setTimeout(() => product.classList.remove('is-highlighted'), 1200);
      };

      featuredLinks.forEach((link) => link.addEventListener('click', (event) => {
        event.preventDefault();
        search.value = '';
        const filterButton = buttons.find((button) => button.dataset.filter === link.dataset.featuredFilter);
        if (filterButton && !filterButton.classList.contains('is-active')) filterButton.click();
        update();
        highlightProduct(link.getAttribute('href'));
      }));
      let activeFilter = 'all';
      const update = () => {
        const query = search.value.toLowerCase().trim();
        let visible = 0;
        cards.forEach((card) => {
          const matchesQuery = card.dataset.name.includes(query);
          const matchesFilter = activeFilter === 'all' || card.dataset.categories.split('|').includes(activeFilter);
          const show = matchesQuery && matchesFilter;
          card.hidden = !show;
          if (show) visible++;
        });
        empty.hidden = visible !== 0;
      };
      buttons.forEach((button) => button.addEventListener('click', () => {
        const wasActive = button.classList.contains('is-active');
        activeFilter = wasActive ? 'all' : button.dataset.filter;
        buttons.forEach((item) => {
          const selected = activeFilter !== 'all' && item === button;
          item.classList.toggle('is-active', selected);
          item.setAttribute('aria-pressed', String(selected));
        });
        update();
      }));
      document.querySelectorAll('[data-filter-link]').forEach((link) => link.addEventListener('click', () => {
        const button = buttons.find((item) => item.dataset.filter === link.dataset.filterLink);
        button?.click();
        document.querySelector('#catalogo').scrollIntoView({ behavior: 'smooth' });
      }));
      search.addEventListener('input', update);
    </script>
  </body>
</html>
